# Appwrite — https://fra.cloud.appwrite.io/console
# Copy this file to `.env` and fill in APPWRITE_API_KEY.

# Public: safe to expose to the browser (bundled into client JS).
NEXT_PUBLIC_APPWRITE_ENDPOINT="https://fra.cloud.appwrite.io/v1"
NEXT_PUBLIC_APPWRITE_PROJECT_ID="6a860a3a002e39a9df91"
NEXT_PUBLIC_APPWRITE_PROJECT_NAME="gldaniunitedacademy.ge"

# Server only: never prefix these with NEXT_PUBLIC_.
# Create at: Project Settings -> API Keys. Scopes needed:
#   tables.read, tables.write, columns.read, columns.write,
#   indexes.read, indexes.write, rows.read, rows.write
APPWRITE_API_KEY=""

# Database / table ids created by `npm run appwrite:migrate`.
APPWRITE_DATABASE_ID="academy"
APPWRITE_ENQUIRIES_TABLE_ID="enquiries"

# Admin account (created by scripts/appwrite-create-admin.mjs).
# The admin panel treats a session belonging to this user id as authorised.
ADMIN_USER_ID=""

# Signs the admin session cookie (any long random string).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""
